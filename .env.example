# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Anthropic Claude API
ANTHROPIC_API_KEY=your_anthropic_api_key

# Resend (Email)
RESEND_API_KEY=your_resend_api_key
EMAIL_FROM=hiring@yourcompany.com
EMAIL_FROM_NAME=TalentAI Hiring

# Slack
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
SLACK_SIGNING_SECRET=your_slack_signing_secret
SLACK_TEAM_ID=your_slack_workspace_id
SLACK_HR_CHANNEL_ID=C_your_hr_channel_id
SLACK_INVITE_EMAIL=your-invite-bot@yourcompany.com

# Google Calendar (OAuth2)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
GOOGLE_REFRESH_TOKEN=your_google_refresh_token
INTERVIEWER_EMAIL=interviewer@yourcompany.com
INTERVIEWER_CALENDAR_ID=primary

# Fireflies.ai
FIREFLIES_API_KEY=your_fireflies_api_key

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
ADMIN_SECRET_KEY=your_admin_secret_for_bypassing_auth
SHORTLIST_THRESHOLD=65
